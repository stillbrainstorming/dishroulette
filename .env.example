# Dishroulette Environment Configuration
# Copy this file to `.env.local` to override settings.
# The base application functions out of the box with the curated local dataset.

# Optional: External Recipe API integration (e.g. Spoonacular, TheMealDB, Edamam)
# VITE_RECIPE_API_URL=https://api.spoonacular.com/recipes
# VITE_RECIPE_API_KEY=your_api_key_here

# Application Configuration
VITE_APP_NAME=Dishroulette
VITE_ENABLE_CONFETTI=true
